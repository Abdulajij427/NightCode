{
    "name": "@nightcode/server",
    "type": "module",
    "private": true,
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "bun run --hot --preload ./src/instrument.ts src/index.ts",
        "start": "bun run --preload ./src/instrument.ts src/index.ts",
        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@nightcode/database": "workspace:*",
        "@nightcode/shared": "workspace:*",
        "@polar-sh/sdk": "0.32.16",
        "resend": "^6.39.0"
    },
    "devDependencies": {
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6"
    }
}
