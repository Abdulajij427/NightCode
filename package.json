{
  "name": "noghtcode",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --watch --preload ./packages/server/src/instrument.ts packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@sentry/bun": "^11.11.0",
    "express": "^5.3.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  }
}
